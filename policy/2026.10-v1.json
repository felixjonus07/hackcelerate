  "routes": {
    "detention_threat_builder": {
      "label": "Attendance support",
      "recipient_role": "class_advisor",
      "approver_role": "class_advisor",
      "copy_roles": ["ecell_coordinator"],
      "sla_working_days": 2,
      "escalate_to": "dean",
      "escalate_after_working_days": 5,
      "closure": "Attendance above the floor for three consecutive weeks, or a condonation decision recorded",
      "shares": ["artifacts_evidence"],
      "escalation_condition": "no_decision"
    },
    "aspiration_mismatch": {
      "label": "Timeline review",
      "recipient_role": "faculty_mentor",
      "approver_role": "faculty_mentor",
      "copy_roles": [],
      "sla_working_days": 5,
      "escalate_to": "hod",
      "escalate_after_working_days": null,
      "closure": "Student records a decision to continue, pivot, or extend the target date",
      "shares": [],
      "escalation_condition": "no_decision"
    },
    "false_positive_high_flyer": {
      "label": "Aptitude and project plan",
      "recipient_role": "placement_officer",
      "approver_role": "placement_officer",
      "copy_roles": [],
      "sla_working_days": 5,
      "escalate_to": "faculty_mentor",
      "escalate_after_working_days": 14,
      "closure": "Aptitude score and one verified project recorded, or student declines with a reason",
      "shares": ["persona_aeg"],
      "escalation_condition": "no_quest_started"
    },
    "drifting_student": {
      "label": "Mapping conversation",
      "recipient_role": "faculty_mentor",
      "approver_role": "faculty_mentor",
      "copy_roles": [],
      "sla_working_days": 7,
      "escalate_to": "hod",
      "escalate_after_working_days": 21,
      "closure": "Track declared and first meeting logged",
      "shares": [],
      "escalation_condition": "no_meeting"
    },
    "attendance_critical": {
      "label": "Attendance critical",
      "recipient_role": "class_advisor",
      "approver_role": "class_advisor",
      "copy_roles": [],
      "sla_working_days": 2,
      "escalate_to": "dean",
      "escalate_after_working_days": 5,
      "closure": "Attendance above the floor for three consecutive weeks, or a condonation decision recorded",
      "shares": [],
      "escalation_condition": "no_decision"
    },
    "integrity_flag": {
      "label": "Evidence review",
      "recipient_role": "faculty_mentor",
      "approver_role": "faculty_mentor",
      "copy_roles": [],
      "sla_working_days": 3,
      "escalate_to": "program_coordinator",
      "escalate_after_working_days": 3,
      "closure": "Flag resolved with a stated reason",
      "shares": [],
      "escalation_condition": "unresolved"
    }
