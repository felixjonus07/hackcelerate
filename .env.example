# ── Core ────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3100

# ── Database (docker compose → postgres on 5434) ───────────────────────
DATABASE_URL=postgres://aspiredge:aspiredge@localhost:5434/aspiredge

# ── Redis (docker compose → redis on 6380): cache + BullMQ queues ──────
REDIS_URL=redis://localhost:6380

# ── Auth (Better Auth) ─────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-plus-random-characters-000000
BETTER_AUTH_URL=http://localhost:3000
# Seeded demo accounts (one per role). Off by default; never enable in production.
DEMO_LOGIN_ENABLED=false
ALLOW_DEMO_LOGIN_IN_PRODUCTION=false
# Password for every seeded demo account (min 12 chars). Generate: openssl rand -base64 18
DEMO_PASSWORD=
# Institution identity provider (OpenID Connect). Leave blank to hide the SSO button.
OIDC_PROVIDER_ID=institution
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# ── LLM narrative layer (OpenRouter) ───────────────────────────────────
# Without a key the system uses the templated rules-only fallback (§9.4).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Pin per term (§9.4). Verify the slug on openrouter.ai/models before use.
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
OPENROUTER_TEMPERATURE=0.2
# Embeddings for pgvector matching (remediation library, opportunities).
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ── Verification sources ───────────────────────────────────────────────
GITHUB_TOKEN=
CROSSREF_MAILTO=

# ── Sessions & sign-in security (§13.2) ───────────────────────────────
SESSION_STAFF_IDLE_MINUTES=30
SESSION_STAFF_MAX_HOURS=8
SESSION_STUDENT_IDLE_MINUTES=30
SESSION_STUDENT_MAX_HOURS=12
SESSION_STUDENT_TRUSTED_DAYS=30
SESSION_WARNING_SECONDS=120
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_SIGNIN_RATE_PER_MINUTE=10
# Student self sign-up at /sign-up. On unless set to false (false closes registration and hides the link).
SIGNUP_ENABLED=true
# New accounts one network address may create per hour.
AUTH_SIGNUP_RATE_PER_HOUR=5
# Header your reverse proxy sets with the real client IP. Behind no proxy, the
# client can spoof it, so set this to your proxy's header in production.
TRUSTED_IP_HEADER=x-forwarded-for

# ── Object storage (§13.3) ─────────────────────────────────────────────
# A private, encrypted S3-compatible bucket. Blank = uploads are kept in .local-data/uploads
# (development only) and served through short-lived signed links.
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# GitHub OAuth app (callback: ${APP_URL}/api/github/callback). It proves a student owns their GitHub
# account so repository ownership can be confirmed. Blank = account linking is off.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Shadow mode (§16.2) ────────────────────────────────────────────────
# When true the system scores everyone but only the project team sees outputs, and nothing is dispatched.
SHADOW_MODE=false
# Comma-separated emails of the project team.
PROJECT_TEAM_EMAILS=

# ── Notifications (§10.1) ──────────────────────────────────────────────
# Email: POST each message as JSON to a relay you run. Blank = messages are written to .local-data/outbox.
NOTIFY_EMAIL_WEBHOOK_URL=
# WhatsApp Business Cloud API, template messages only, only to people who opted in. Blank = off.
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=

# ── ERP import (§6.2) ──────────────────────────────────────────────────
# Path of the registrar's nightly CSV export. Leave blank to skip the import;
# a configured path that does not exist marks the baseline data stale.
# Generate a sample from the seeded students with: npm run erp:sample
ERP_EXPORT_FILE=

# ── Policy ─────────────────────────────────────────────────────────────
# File name inside policy/ (path prefixes are ignored).
POLICY_FILE=2026.10-v1.json
